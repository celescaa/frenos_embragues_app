# Copiá este archivo a ".env" (sin ".example") y completá los valores.
# El ".env" real NUNCA se sube al repositorio (ver .gitignore) ni se pega en el chat.

# ===========================================================================
# OBLIGATORIAS: sin estas el sistema no arranca, o arranca roto.
# ===========================================================================

# --- Base de datos (Postgres) ----------------------------------------------

# Cadena de conexión a Postgres. En desarrollo local, la que imprime
# `npx supabase start` (ver CLAUDE.md, "Migración a Postgres") — si se deja
# vacío, el sistema usa ese mismo valor por default:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# En producción, del panel de Supabase (Project Settings > Database):
#   App en Vercel  -> pooler en modo TRANSACCIÓN, puerto 6543
#   Scripts de scripts/ -> pooler en modo SESIÓN, puerto 5432
# Los scripts hacen cargas masivas y son procesos largos: por el pooler de
# transacción pueden cortarse a mitad de camino.
#   .../pooler.supabase.com:6543/postgres   (app)
#   .../pooler.supabase.com:5432/postgres   (scripts)
DATABASE_URL=

# --- Sesión ----------------------------------------------------------------

# Clave con la que se firma la cookie de sesión. En producción NO es
# opcional: en Vercel no hay disco, así que sin esta variable la clave se
# regenera en cada arranque en frío y se cierran todas las sesiones abiertas.
# Corriendo local se puede dejar vacía (se guarda en el archivo .secret_key).
# Generar con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "1" SOLO donde el sistema se sirve por HTTPS (Vercel). Hace que la cookie
# de sesión no viaje por HTTP. Corriendo local tiene que quedar vacía: con
# http://127.0.0.1 la cookie no viajaría nunca y no se podría iniciar sesión.
SESSION_COOKIE_SECURE=

# --- Supabase (autenticación y fotos de producto) --------------------------

# URL del proyecto de Supabase. Local: http://127.0.0.1:54321
SUPABASE_URL=

# Clave pública ("anon" / publishable). Solo permite iniciar sesión.
SUPABASE_ANON_KEY=

# Clave de servicio ("service_role" / secret). SALTEA TODAS las políticas de
# la base: es la llave maestra. Solo la usa el servidor, para dar de alta
# usuarios y subir fotos. NUNCA en el navegador, NUNCA en el repositorio. Si
# se llega a filtrar, se considera comprometida y hay que rotarla desde el
# panel de Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================================================
# OPCIONALES: sin estas el sistema funciona igual, con la función
# correspondiente desactivada y avisando en pantalla. Se pueden completar más
# adelante, cuando existan las cuentas.
# ===========================================================================

# Access token de tu cuenta en https://app.afipsdk.com (gratis: 1 CUIT, 1000 requests/mes).
# Sin este valor, el sistema sigue funcionando pero no emite facturas: las
# ventas con tarjeta o transferencia quedan marcadas como "sin_configurar",
# con un botón para reintentar desde el comprobante. La venta se registra y
# el stock baja igual.
AFIPSDK_ACCESS_TOKEN=

# CUIT a facturar, sin guiones. Dejalo vacío para usar el CUIT de prueba
# compartido de Afip SDK (modo desarrollo, ambiente de homologación/test).
# Cuando esté todo probado, poner acá el CUIT real del negocio: 20350753940
AFIPSDK_CUIT=

# "1" para facturar en producción con el CUIT real (hace falta certificado).
# Vacío o cualquier otro valor = ambiente de prueba (homologación).
AFIPSDK_PRODUCTION=

# Punto de venta de ARCA a usar. Default: 1
AFIPSDK_PUNTO_VENTA=1

# Certificado y clave, SOLO para facturar en producción con el CUIT real.
# Se generan en el panel de Afip SDK siguiendo su guía "Ir a producción".
AFIPSDK_CERT=
AFIPSDK_KEY=

# --- Tienda online / cobro con Mercado Pago -------------------------------

# Access token de la cuenta de Mercado Pago del negocio (panel de
# Tus integraciones > credenciales). Sin esto, el catálogo funciona pero
# el checkout avisa que el cobro online no está disponible todavía.
MERCADOPAGO_ACCESS_TOKEN=

# URL pública (https) donde corre el sistema. Mercado Pago la necesita para
# mandar al comprador de vuelta y para avisar por webhook que se pagó — NO
# puede ser 127.0.0.1. Mientras se prueba en la compu local, se puede usar
# una URL temporal de ngrok (https://algo.ngrok-free.app); cuando el sistema
# esté alojado en internet, poner acá el dominio real (por ejemplo
# https://frenosi.com.ar).
STORE_BASE_URL=

# "1" para cobrar en producción de verdad (con las credenciales reales de
# la cuenta del negocio). Vacío o cualquier otro valor = credenciales de
# prueba de Mercado Pago (no cobra plata real).
MERCADOPAGO_PRODUCTION=

# "Clave secreta" del webhook (panel de Mercado Pago > Tus integraciones >
# Webhooks > Configurar notificaciones). Opcional pero recomendada: permite
# verificar que la notificación de pago realmente vino de Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Envío del comprobante por mail ---------------------------------------

# Servidor SMTP de la cuenta que va a mandar los comprobantes. Con Gmail:
# smtp.gmail.com. Sin esto configurado, el botón "Enviar por mail" muestra
# un aviso explicando que falta configurarlo (no rompe nada).
SMTP_HOST=

# Puerto SMTP. 587 = STARTTLS (default), 465 = SSL directo (poner
# SMTP_USE_SSL=1 en ese caso).
SMTP_PORT=587

# Usuario de la cuenta de mail (ej: repuestossanignacio@gmail.com).
SMTP_USER=

# Contraseña de esa cuenta. Con Gmail NO es la contraseña normal: hay que
# generar una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (necesita verificación en dos
# pasos activada en la cuenta de Google).
SMTP_PASSWORD=

# Remitente que ve el cliente en el mail. Si se deja vacío, se usa SMTP_USER.
SMTP_FROM=

# "1" para conectar por SSL directo (puerto 465 típicamente). Vacío o
# cualquier otro valor = STARTTLS (puerto 587, lo normal con Gmail).
SMTP_USE_SSL=
